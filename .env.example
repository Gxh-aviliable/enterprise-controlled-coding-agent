# App
DEBUG=false

# Optional Docker host ports (container ports stay fixed)
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=agent_user
MYSQL_PASSWORD=agent_password
MYSQL_DATABASE=enterprise_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET_KEY=your-secret-key-change-in-production
# Generate a real value before server/Docker startup:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Password reset email (optional)
# If SMTP is not configured, reset codes are written to the backend log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_CODE_LENGTH=6

# Workspace storage
# Local macOS/Windows development can use a project-local directory:
WORKSPACE_BASE=./workspaces
# Linux server/Docker deployments commonly use:
# WORKSPACE_BASE=/workspaces

# Workspace file opening
# local-vscode: opens the authenticated user's workspace via vscode://file/...
# web-vscode: opens a configured code-server/openvscode-server URL
# Use local-vscode for local development. Use web-vscode for remote server deployments.
# In web-vscode mode, VSCODE_WORKSPACE_PATH is a multi-user base path by default;
# the backend appends user_<id>. Use {user_id} or {workspace_name} for custom layouts.
FILE_OPEN_MODE=local-vscode
VSCODE_WEB_BASE_URL=
VSCODE_WEB_URL_TEMPLATE=
VSCODE_WORKSPACE_PATH=./workspaces
# Server example:
# FILE_OPEN_MODE=web-vscode
# VSCODE_WORKSPACE_PATH=/workspaces

# LLM Provider
# Supported: "anthropic" | "glm" | "deepseek" | "openai" | "mimo"
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-v4-flash
MODEL_MAX_OUTPUT_TOKENS=16384

# Reliable execution budgets
MAX_AGENT_ROUNDS=20
MAX_TOOL_CALLS_PER_TASK=25
TASK_TOKEN_BUDGET=4000000
# Zero disables the per-session cumulative token guard. Per-task, round, tool,
# timeout and administrator daily/monthly limits remain active.
SESSION_TOKEN_BUDGET=0
# Configure the selected model's documented context window. The server rejects
# zero because a missing boundary can overflow the provider before compression.
MODEL_CONTEXT_WINDOW_TOKENS=1000000
# Must name the same model as MODEL_ID; update both after verifying a new model.
MODEL_CONTEXT_WINDOW_MODEL_ID=deepseek-v4-flash
# Automatic compaction starts at 80% of the model window: 800000 tokens here.
CONTEXT_COMPRESSION_RATIO=0.8
MICROCOMPACT_MIN_CHARS=1000
# Tool artifacts retain a larger, redacted evidence snapshot than the text
# injected into the model, while remaining bounded against disk exhaustion.
TOOL_SOURCE_CAPTURE_MAX_BYTES=4000000
TOOL_ARTIFACT_MAX_CHARS=2000000
CONTEXT_SUMMARY_MAX_TOKENS=50000
CONTEXT_SUMMARY_OUTPUT_RESERVE_TOKENS=4096
VERIFICATION_MAX_ATTEMPTS=2
CONFIRMATION_TIMEOUT_SECONDS=300
ACTIVE_TRACE_LEASE_SECONDS=1200
CANCEL_CONVERGENCE_WAIT_SECONDS=5
DURABLE_HISTORY_MAX_CHARS=120000
# Keep false for the measured single-Agent baseline. Enable only for comparison runs.
ENABLE_MULTI_AGENT=false
ENABLE_LONG_TERM_MEMORY=true
# Long-term memory v2 governance
MEMORY_ADMISSION_MIN_IMPORTANCE=0.65
MEMORY_RELEVANCE_MAX_DISTANCE=0.8
MEMORY_DEDUP_MAX_DISTANCE=0.3
MEMORY_CJK_LEXICAL_MIN_SCORE=0.08
MEMORY_CJK_RELATIVE_SCORE=0.75

# Legacy (optional, fallback for anthropic provider)
ANTHROPIC_API_KEY=

# Chroma (vector database)
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Existing cache is always loaded offline; set false to require a preloaded cache.
EMBEDDING_ALLOW_DOWNLOAD=true
SHARED_SKILLS_DIR=./shared_skills
MANAGED_SHARED_SKILLS_DIR=./managed_shared_skills

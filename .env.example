# App
DEBUG=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agent_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=enterprise_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET_KEY=your-secret-key-change-in-production

# Password reset email (optional)
# If SMTP is not configured, reset codes are written to the backend log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_CODE_LENGTH=6

# Workspace file opening
# local-vscode: opens the authenticated user's workspace via vscode://file/...
# web-vscode: opens a configured code-server/openvscode-server URL
# In web-vscode mode, VSCODE_WORKSPACE_PATH is a multi-user base path by default;
# the backend appends user_<id>. Use {user_id} or {workspace_name} for custom layouts.
FILE_OPEN_MODE=local-vscode
VSCODE_WEB_BASE_URL=
VSCODE_WEB_URL_TEMPLATE=
VSCODE_WORKSPACE_PATH=/srv/workspaces

# LLM Provider
# Supported: "anthropic" | "glm" | "deepseek" | "openai" | "mimo"
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key
LLM_BASE_URL=
MODEL_ID=claude-sonnet-4-6

# Legacy (optional, fallback for anthropic provider)
ANTHROPIC_API_KEY=

# Chroma (vector database)
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

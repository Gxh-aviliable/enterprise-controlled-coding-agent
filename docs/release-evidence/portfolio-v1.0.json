  "limitations": [
    {
      "id": "agent-host-paths",
      "statement": "The raw Agent JSON contains local host absolute paths from the recorded macOS run and should be treated as reproducibility evidence, not a portable replay bundle."
    },
    {
      "id": "ephemeral-tool-artifacts",
      "statement": "Benchmark workspaces are temporary, so tool artifact files referenced by recorded paths were not permanently retained after the run."
    },
    {
      "id": "memory-application-not-measured",
      "statement": "The Memory benchmark measures retrieval and filtering; it does not prove that a chat model correctly applied an injected memory."
    },
    {
      "id": "platform-not-model-quality",
      "statement": "The Platform benchmark is deterministic and offline; its 30/30 result is not an LLM or autonomous Agent capability score."
    }
  ]
